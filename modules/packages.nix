# Packages module of Spark.
# Ships the base system: drivers, codecs, a Rust-first tool set, and the
# curated desktop application set. Every application is single-purpose;
# where one program covers several needs it is preferred over several
# narrow ones. No GNOME or KDE utilities ship at all: the file manager,
# text editor, terminal and archive handling of the desktop come from the
# COSMIC environment itself (modules/desktop.nix).
{ config, pkgs, lib, nixpak, nix-software-center, helium, ... }:

let
  # ConvertX is packaged from its upstream source (web-based converter).
  # The upstream project uses Bun with a binary lockfile (bun.lockb), so
  # there is no nixpkgs fetcher for its dependencies. The node_modules
  # directory is produced by a fixed-output derivation: the output hash
  # pins the dependency tree exactly, and network access is allowed inside
  # because the output is fixed.
  src = pkgs.fetchFromGitHub {
    owner = "C4illin";
    repo = "ConvertX";
    tag = "v0.10.0";
    hash = "sha256-tJw/k5nPc67VJyfjRSAKKXijqI4klw6n7jDROlfGE4E=";
  };

  bunDeps = pkgs.stdenvNoCC.mkDerivation {
    pname = "convertx-bun-deps";
    version = "0.10.0";
    inherit src;
    nativeBuildInputs = [ pkgs.bun ];
    # HOME must be writable for the Bun cache inside the sandbox.
    buildPhase = ''
      export HOME=$TMPDIR
      bun install --frozen-lockfile
    '';
    installPhase = ''
      mkdir -p $out
      cp -r node_modules $out/node_modules
    '';
    outputHashAlgo = "sha256";
    outputHashMode = "recursive";
    # The dependency tree is pinned byte for byte by this output hash.
    outputHash = "sha256-ZWRbffhYNj7HHGnRFhSJuPVfxPx5w6z2NiSR6Eh6D44=";
  };

  convertx = pkgs.stdenv.mkDerivation rec {
    pname = "convertx";
    version = "0.10.0";
    inherit src;
    nativeBuildInputs = [
      pkgs.bun
    ];
    # The pinned dependency tree is linked into the build directory.
    preBuild = ''
      ln -s ${bunDeps}/node_modules node_modules
    '';
    # The build script compiles the Tailwind stylesheet into public/generated.css.
    # The postcss wrapper in node_modules/.bin has a '#!/usr/bin/env node'
    # shebang, which cannot run in the Nix sandbox (there is no /usr/bin/env,
    # and node_modules is a read-only store symlink). Bun interprets the file
    # as plain JavaScript, where the shebang line is only a comment, so the
    # same binary is invoked directly through Bun instead.
    buildPhase = ''
      runHook preBuild
      bun ./node_modules/.bin/postcss ./src/main.css -o ./public/generated.css
      runHook postBuild
    '';
    # ConvertX is an Elysia (Bun) application, not a compiled bundle: the
    # sources, the generated stylesheet and the dependency tree are installed
    # as-is, and the launcher starts the Bun runtime directly.
    installPhase = ''
      runHook preInstall
      mkdir -p $out/lib
      cp -r src public package.json $out/lib/
      ln -s ${bunDeps}/node_modules $out/lib/node_modules
      mkdir -p $out/bin
      # The launcher is generated HERE, at build time: the store path of the
      # package and the Bun binary are baked in as literal strings, because
      # the runtime service environment has no $out variable to expand.
      printf '%s\n' '#!/bin/sh' "cd $out/lib" "exec ${pkgs.bun}/bin/bun run src/index.tsx" > $out/bin/convertx
      chmod +x $out/bin/convertx
      runHook postInstall
    '';
    meta = {
      description = "Self-hosted online file converter (images, audio, video, documents)";
      homepage = "https://github.com/C4illin/ConvertX";
      license = lib.licenses.agpl3Only;
    };
  };
in
{
  # All firmware and microcode ship by default (Intel/AMD CPUs, GPUs, Wi-Fi).
  hardware.cpu.intel.updateMicrocode = true;
  hardware.cpu.amd.updateMicrocode = true;

  # GPU driver policy: the kernel modesetting driver covers Intel, AMD and
  # every virtual GPU out of the box, and NVIDIA hardware works through the
  # free nouveau driver. Machines that need the proprietary NVIDIA stack get
  # it from the configuration generated by the installer for that machine;
  # the global configuration stays on the free drivers.

  # PipeWire handles audio AND cameras/microphones with a single stack.
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true; # PulseAudio compatibility for legacy apps.
    jack.enable = true;
    wireplumber.enable = true; # WirePlumber manages device permissions automatically.
  };

  # Bluetooth works out of the box and auto-accepts known paired devices.
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
  };
  services.blueman.enable = true;

  # Webcam support (v4l) ships by default: the v4l2loopback kernel module
  # provides a virtual camera device.
  boot.extraModulePackages = [
    # NixOS merges every entry of boot.extraModulePackages into the kernel
    # module tree with a buildEnv, and that merge fails on any file path
    # that occurs in two inputs. The only payload of an out-of-tree module
    # package is the kernel module file itself (v4l2loopback.ko); every
    # other file under lib/modules is depmod metadata (modules.softdep,
    # modules.dep, modules.builtin.alias.bin and similar) that duplicates
    # the authoritative metadata of the kernel modules package inside the
    # merged tree, where the depmod database is rebuilt over the whole
    # merged module set. Those duplicate metadata files collide during
    # the merge, so everything under lib/modules that is not a kernel
    # module file is removed right after the package is installed.
    (config.boot.kernelPackages.v4l2loopback.overrideAttrs (oldAttrs: {
      postInstall = (oldAttrs.postInstall or "") + ''
        find $out/lib/modules -type f ! -name '*.ko*' -delete
      '';
    }))
  ];

  # The base system: a minimal, Rust-first tool set.
  # The interactive shell shadows classic GNU commands with Rust
  # replacements through aliases (modules/shell.nix); the GNU binaries stay
  # in the closure because NixOS activation and service scripts depend on
  # them, but they leave the user's everyday PATH.
  environment.defaultPackages = lib.mkForce [ ]; # No perl/strace/rsync defaults.

  environment.systemPackages = with pkgs; [
    # --- Editor ---
    nano            # The only terminal editor. Vim/Emacs are intentionally absent.

    # --- Rust replacements for the classic Unix toolbox ---
    fd              # Rust. Replaces find.
    ripgrep         # Rust. Replaces grep.
    eza             # Rust. Replaces ls.
    bat             # Rust. Replaces cat (plain style by default via alias).
    sd              # Rust. Replaces sed for interactive use.
    dust            # Rust. Replaces du.
    duf             # Rust. Replaces df.
    procs           # Rust. Replaces ps/top.
    difftastic      # Rust. Replaces diff for interactive use.
    zoxide          # Rust. Smarter directory jumping ("z foo").

    # --- Copying and documentation ---
    rsync           # Powers the progress-bar cp alias.
    man-db          # The man page database.

    # --- Administration and diagnostics ---
    ldns            # drill: DNS diagnostics replacing dig/nslookup.
    socat           # Universal socket relay for debugging and plumbing.
    tcpdump         # Packet capture for support sessions.
    smartmontools   # SMART health monitoring of rotating disks and SSDs.
    nvme-cli        # NVMe device management and health monitoring.

    # ========================================================
    # --- The curated desktop application set ---
    # One job per app; combos preferred over narrow tools. All
    # applications are cross-desktop; the desktop utilities
    # (files, editor, terminal, archive extraction) come from
    # COSMIC itself.
    # ========================================================

    # --- Core daily tools ---
    ghostty         # Terminal. GPU-accelerated, minimal, fast.
    pkgs.helium     # Browser (Helium, Chromium-based; the module arg `helium`
                    # shadows the overlay attribute, so it is referenced explicitly).
    joplin-desktop  # Notes AND reminders/to-do lists (one app, two jobs).

    # --- Office ---
    onlyoffice-desktopeditors # Office suite.

    # --- Capture ---
    kooha           # Screen recorder.
    flameshot       # Screenshots.
    satty           # Screenshot annotation and quick markup.

    # --- Media viewing and editing ---
    pqiv            # Fast image viewer for every common format.
    gimp            # Full image editing.
    webcamoid       # Camera (cross-desktop Qt app).
    vlc             # Video AND audio player (one app, two jobs).
    strawberry      # Music library manager and player.
    shotcut         # Video editor.
    tenacity        # Audio editor (telemetry-free fork of Audacity).

    # --- Communication ---
    thunderbird     # Mail AND calendar (one app, two jobs).

    # --- Utilities ---
    qalculate-qt    # Calculator (Qt, scientific, pretty).
    newsflash       # News/RSS reader (independent GTK4 app).
    mission-center  # System monitor (CPU/RAM/disk/net/GPU, GTK4).
    mousam          # Weather.
    pavucontrol     # Point-and-click volume control.
    _1password-gui  # Password manager (1Password).
    _1password-cli  # 1Password CLI for terminal workflows.

    # --- The app store ---
    # Nix Software Center is not packaged in nixpkgs; it arrives
    # through the flake input of the same name.
    nix-software-center.packages.${pkgs.stdenv.hostPlatform.system}.nix-software-center

    # --- Multimedia codecs: everything decodes, always ---
    ffmpeg-full
    gst_all_1.gstreamer
    gst_all_1.gst-plugins-base
    gst_all_1.gst-plugins-good
    gst_all_1.gst-plugins-bad
    gst_all_1.gst-plugins-ugly
    gst_all_1.gst-libav

    # --- Hardware utilities ---
    usbutils pciutils # "lsusb"/"lspci" for support sessions.

    # --- The Spark distro converter app ---
    convertx
  ];

  # The Helium browser arrives through its flake: an overlay exposes
  # pkgs.helium, and its NixOS module installs it system-wide with the
  # Spark policy set (no telemetry, no built-in password manager, no
  # browser sign-in).
  nixpkgs.overlays = [ helium.overlays.default ];

  imports = [ helium.nixosModules.default ];

  programs.helium = {
    enable = true;
    policies = {
      "MetricsReportingEnabled" = false;
      "PasswordManagerEnabled" = false;
      "BrowserSignin" = 0;
      "SyncDisabled" = true;
      "SafeBrowsingEnabled" = true;
    };
  };

  # ConvertX runs as a user service on 127.0.0.1:3055 (firewalled from LAN).
  systemd.user.services.convertx = {
    description = "ConvertX file converter";
    wantedBy = [ "default.target" ];
    serviceConfig = {
      ExecStart = "${convertx}/bin/convertx";
      WorkingDirectory = "${convertx}/lib";
      Restart = "on-failure";
      # ConvertX binds 127.0.0.1:3055 by default; the nftables ruleset
      # (modules/security.nix) never forwards that port to the LAN.
    };
  };
}
